# =============================================================================
# Beausoleil Ultimate Team — variables d'environnement
# Copie ce fichier en `.env` (local) et renseigne les mêmes variables sur Vercel.
# =============================================================================

# --- Base de données PostgreSQL (Neon ou Supabase) ---------------------------
# URL "poolée" utilisée par l'application (Neon : -pooler ; Supabase : port 6543 + ?pgbouncer=true)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/beausoleil?sslmode=require"
# URL directe (non poolée) utilisée par les migrations Prisma. En local : même valeur que DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/beausoleil?sslmode=require"

# --- Auth.js ------------------------------------------------------------------
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
# URL publique (facultatif sur Vercel, conseillé ailleurs)
# AUTH_URL="https://beausoleil-ultimate-team.vercel.app"

# Google OAuth (console.cloud.google.com → Identifiants → ID client OAuth "Application Web")
# URI de redirection autorisée : https://TON-DOMAINE/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Administration -------------------------------------------------------------
# Clé secrète (12 caractères minimum) pour devenir ADMIN via /admin/setup.
# Utilisable une seule fois : dès qu'un ADMIN existe, la page est désactivée.
ADMIN_SETUP_SECRET=""

# Facultatif : création de l'ADMIN par `npm run db:seed`
# ADMIN_EMAIL="toi@exemple.fr"
# ADMIN_NICKNAME="Le Boss"
# ADMIN_PASSWORD=""

# --- Photos de profil (Vercel Blob) -------------------------------------------
# Créé automatiquement quand tu ajoutes un store Blob au projet Vercel.
BLOB_READ_WRITE_TOKEN=""

# --- Tâches planifiées (Vercel Cron) ------------------------------------------
# Vercel envoie "Authorization: Bearer $CRON_SECRET" aux routes /api/cron/*
CRON_SECRET=""

# --- Horaires du vote (valeurs par défaut, modifiables dans /admin) -----------
APP_TIMEZONE="Europe/Paris"
VOTE_START_TIME="20:00"
VOTE_END_TIME="08:00"
